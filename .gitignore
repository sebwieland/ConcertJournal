# Root .gitignore for Concert Journal Monorepo
*.ser

# ================
# Java / Maven
# ================
target/
!target/classes/
!target/test-classes/
*.class
.mvn/
.m2/
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-check-suppressions.xml
spring-boot-devtools.properties

# ================
# IDE
# ================
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
.factorypath
.tokens/

# ================
# Node.js / Frontend
# ================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn
.pnpm-store/
package-lock.json.backup

# ================
# Build outputs
# ================
dist/
build/
out/
.next/
.nuxt/
.cache/
parcel-bundle-report/

# Compiled JavaScript (should not be in src/)
src/**/*.js
src/**/*.js.map
!src/**/*.test.js
!src/**/*.spec.js
!src/**/*.config.js

# ================
# Environment variables
# ================
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# ================
# Logs
# ================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================
# Docker
# ================
.docker/
compose/
docker-compose.override.yml

# ================
# Database
# ================
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
/backend/DB/
*.trace.db
*.lock.db
backup.sql

# ================
# Testing / Coverage
# ================
coverage/
.nyc_output/
.jacoco/
jacoco.exec
vitest-results/

# ================
# Local development
# ================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
sessionTmp/

# ================
# Spring Boot
# ================
.springbeans
.springlivebeans

# ================
