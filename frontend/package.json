{
  "name": "concertjournal",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-data-grid": "^7.28.3",
    "@mui/x-date-pickers": "^7.28.3",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "material-ui-confirm": "^4.0.0",
    "musicbrainz-api": "^0.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.0.0",
    "react-swipeable-list": "^1.10.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.1",
    "playwright": "^1.49.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.1",
    "terser": "^5.29.2",
    "typescript": "^5.0.0",
    "vite": "^5.1.4",
    "vite-plugin-sitemap": "^0.5.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^1.2.1"
  },
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "start:local": "cross-env NODE_ENV=development vite --port 3000 --mode dev-local",
    "start:dev": "cross-env NODE_ENV=development HMR_HOST=0.0.0.0 HMR_PORT=24678 vite --host 0.0.0.0 --port 3000",
    "start:prod": "serve -s dist -p 3000 --single",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "node e2e/e2e.cjs"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "html",
        "lcov"
      ],
      "exclude": [
        "node_modules/",
        "dist/",
        "**/*.test.tsx",
        "**/*.test.ts"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off"
    },
    "overrides": [
      {
        "files": [
          "src/tests/**/*.{ts,tsx,js}"
        ],
        "rules": {
          "@typescript-eslint/no-explicit-any": "off",
          "@typescript-eslint/ban-ts-comment": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
