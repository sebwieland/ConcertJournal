{
  "name": "concertjournal",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.15.0",
    "@mui/x-data-grid": "^9.15.0",
    "@mui/x-date-pickers": "^9.15.0",
    "axios": "^1.8.4",
    "dayjs": "^1.11.23",
    "material-ui-confirm": "^4.0.0",
    "musicbrainz-api": "^1.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.18.4",
    "react-swipeable-list": "^1.10.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "playwright": "^1.49.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "start:local": "cross-env NODE_ENV=development vite --port 3000 --mode dev-local",
    "start:dev": "cross-env NODE_ENV=development HMR_HOST=0.0.0.0 HMR_PORT=24678 vite --host 0.0.0.0 --port 3000",
    "start:prod": "serve -s dist -p 3000 --single",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "node e2e/e2e.cjs"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "html",
        "lcov"
      ],
      "exclude": [
        "node_modules/",
        "dist/",
        "**/*.test.tsx",
        "**/*.test.ts"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off"
    },
    "overrides": [
      {
        "files": [
          "src/tests/**/*.{ts,tsx,js}"
        ],
        "rules": {
          "@typescript-eslint/no-explicit-any": "off",
          "@typescript-eslint/ban-ts-comment": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
